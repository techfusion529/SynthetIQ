# ============================================================
# SynthetIQ — Global Environment & Engine Configuration
# ============================================================

# Google Cloud Project
GCP_PROJECT_ID=synthetiq-production
GCP_REGION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# Gemini AI (System 2 Reasoning)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=8192
GEMINI_SAFETY_SETTINGS=BLOCK_MEDIUM_AND_ABOVE

# Multi-Agent Orchestration
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=120
AGENT_ENABLE_MEMORY=true
AGENT_MEMORY_BACKEND=redis
REDIS_URL=redis://localhost:6379/0

# TypeSafe Jev (System 1 Reflex) Mode
# Options: ML_MODEL | HYBRID_ENSEMBLE | REFLEX_PHYSICS_ONLY
JEV_MODE=ML_MODEL
JEV_MODEL_PATH=./models/scada_fraud_detector_v1.pkl
JEV_TORQUE_THRESHOLD_NM=8.0
JEV_POWER_FACTOR_MIN=0.78
JEV_POWER_FACTOR_MAX=0.96
JEV_CONFIDENCE_THRESHOLD=0.85

# Ollama (Local Privacy Layer - Gemma 2B)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_ENABLE_PII_SCRUBBING=true

# Google BigQuery (ERP Data)
BIGQUERY_DATASET_ID=epr_compliance
BIGQUERY_SALES_TABLE=sales_data
BIGQUERY_LOCATION=asia-south1

# Google Pub/Sub (SCADA Telemetry)
PUBSUB_SCADA_TOPIC=scada-telemetry-stream
PUBSUB_SCADA_SUBSCRIPTION=scada-telemetry-sub

# External APIs
CPCB_PORTAL_URL=https://cpcb.nic.in/api/v1
CPCB_API_KEY=
CPCB_DIGITAL_SIGNATURE_PATH=./credentials/dsc_certificate.p12
CPCB_DSC_PASSWORD=

GST_API_URL=https://gst.gov.in/api/v2.1
GST_API_KEY=
GST_GSTIN=

# Firebase Authentication (Human-in-the-Loop)
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_SDK_PATH=./credentials/firebase-admin.json
FIREBASE_WEB_API_KEY=

# Database (multi-tenant state — SQLite for dev, Postgres for production)
DATABASE_URL=sqlite+aiosqlite:///./synthetiq.db
# DATABASE_URL=postgresql+asyncpg://synthetiq:synthetiq@localhost:5433/synthetiq
DB_ECHO=false

# Microservice Endpoints (Local & Docker)
API_PORT=8000
MCP_URL=http://localhost:8001
SIMULATOR_URL=http://localhost:9091
MOCKS_URL=http://localhost:8002
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Observability
ENABLE_TELEMETRY=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Cost Management
LLM_COST_TRACKING_ENABLED=true
LLM_MONTHLY_BUDGET_USD=500
LLM_ALERT_THRESHOLD_PERCENT=80

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTH_DEV_MODE=false

# Development/Testing
ENABLE_MOCK_MODE=false
LOG_LEVEL=INFO
