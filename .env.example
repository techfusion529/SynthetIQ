# ============================================================
# SynthetIQ — Environment Variables Template
# Copy to .env and fill in real values before running locally.
# ============================================================

# --- Google Cloud ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# --- TypeSafe Jev ---
JEV_API_KEY=your-jev-api-key
JEV_API_URL=https://api.typesafe.ai/v1

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=synthetiq-main

# --- BigQuery ---
BQ_DATASET=synthetiq
BQ_LOCATION=asia-south1

# --- Pub/Sub ---
PUBSUB_PROJECT_ID=${GCP_PROJECT_ID}
SCADA_TOPIC=scada-telemetry
SCADA_SUBSCRIPTION=scada-telemetry-sub

# --- Ollama (Gemma 2B PII Scrubber) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# --- Firebase Auth ---
FIREBASE_PROJECT_ID=${GCP_PROJECT_ID}

# --- API Gateway ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Simulator ---
SIMULATOR_STREAM_RATE_HZ=1
SIMULATOR_PROFILE=genuine

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
