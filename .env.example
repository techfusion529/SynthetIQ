# ============================================================
# SynthetIQ — Environment Configuration Template
# For Local Dev: Copy to .env
# For CI/CD & Kubernetes: Configure in GitHub Secrets & Variables
# ============================================================

# ------------------------------------------------------------
# 1. GitHub Variables (Non-sensitive / Environment Settings)
# ------------------------------------------------------------
GCP_PROJECT_ID=synthetiq-dev
GCP_REGION=asia-south1
ARTIFACT_REPOSITORY=synthetiq-docker-repo
GKE_CLUSTER_NAME=synthetiq-cluster
GKE_CLUSTER_ZONE=asia-south1-a
BIGQUERY_DATASET_ID=epr_compliance
BIGQUERY_SALES_TABLE=sales_data
BIGQUERY_LOCATION=asia-south1
PUBSUB_SCADA_TOPIC=scada-telemetry-stream
PUBSUB_SCADA_SUBSCRIPTION=scada-telemetry-sub
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
JEV_MODE=NIMBLE_PRIMARY
API_PORT=8000
AUTH_DEV_MODE=true

# ------------------------------------------------------------
# 2. GitHub Secrets (Sensitive Credentials & Keys)
# ------------------------------------------------------------
# Service Account Key JSON with Artifact Registry + GKE Deployer roles
GCP_SA_KEY={"type": "service_account", ...}

# Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

# Production PostgreSQL Database Connection URL
DATABASE_URL=postgresql+asyncpg://synthetiq:password@postgres-host:5432/synthetiq

# JWT Signing Secret for Multi-Tenant Auth
JWT_SECRET=your-secure-random-jwt-secret-key-32-chars-minimum

# Optional Redis Connection URL
REDIS_URL=redis://redis-host:6379/0
