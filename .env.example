# ============================================================
# SynthetIQ — Global Environment & Engine Configuration
# ============================================================

# Gemini AI (System 2 Reasoning)
# Set your real Google Gemini API Key here (starts with AIzaSy...)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

# TypeSafe Jev (System 1 Reflex) Mode
# Options: HYBRID_ENSEMBLE | REFLEX_PHYSICS_ONLY | DEEP_FORENSIC_ONLY
JEV_MODE=HYBRID_ENSEMBLE
JEV_TORQUE_THRESHOLD_NM=8.0
JEV_POWER_FACTOR_MIN=0.78
JEV_POWER_FACTOR_MAX=0.96

# Microservice Endpoints (Local & Docker)
API_PORT=8000
MCP_URL=http://localhost:8001
SIMULATOR_URL=http://localhost:9091
MOCKS_URL=http://localhost:8002
TEMPORAL_HOST=localhost:7233

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTH_DEV_MODE=true
