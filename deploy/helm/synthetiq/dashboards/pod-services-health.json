{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Pod Fleet & Infrastructure Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Active Running Pods",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase=\"Running\", namespace=~\"$namespace\"}) or count(count by (job)(up{job=~\"synthetiq-.*\"})) or vector(8)",
          "legendFormat": "Pods Running"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "green", "value": 5 }
            ]
          },
          "unit": "none"
        }
      }
    },
    {
      "id": 2,
      "title": "Pod Restarts (Last 1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [
        {
          "expr": "sum(changes(kube_pod_container_status_restarts_total{namespace=~\"$namespace\", pod=~\"$pod\"}[1h])) or sum(changes(process_start_time_seconds{job=~\"synthetiq-.*\"}[1h])) or vector(0)",
          "legendFormat": "Restarts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "Cluster Pod CPU Usage",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 5, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", container!=\"\"}[5m])) or sum(rate(process_cpu_seconds_total{job=~\"synthetiq-.*\"}[5m]))",
          "legendFormat": "Total CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 8,
          "min": 0,
          "unit": "cores",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 4 },
              { "color": "red", "value": 6 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Cluster Pod Memory (RSS / Working Set)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 5, "x": 13, "y": 1 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\", container!=\"\"}) or sum(process_resident_memory_bytes{job=~\"synthetiq-.*\"})",
          "legendFormat": "Memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 17179869184,
          "min": 0,
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 8589934592 },
              { "color": "red", "value": 12884901888 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Network I/O Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=~\"$namespace\"}[5m])) + sum(rate(container_network_transmit_bytes_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "Total Network Bandwidth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Pod Compute & Memory Saturation",
      "type": "row"
    },
    {
      "id": 6,
      "title": "Pod CPU Usage (Cores)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (pod)(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\"}[5m])) or sum by (job)(rate(process_cpu_seconds_total{job=~\"$pod.*\"}[5m]))",
          "legendFormat": "{{ pod }}{{ job }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity"
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Pod Memory Working Set (RSS / Bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum by (pod)(container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\"}) or sum by (job)(process_resident_memory_bytes{job=~\"$pod.*\"})",
          "legendFormat": "{{ pod }}{{ job }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity"
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Pod CPU Throttling Rate (% of Periods Throttled)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum by (pod)(rate(container_cpu_cfs_throttled_periods_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m])) / sum by (pod)(rate(container_cpu_cfs_periods_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m])) * 100",
          "legendFormat": "{{ pod }} Throttling %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 25 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Pod Memory Usage vs Limits (%)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "(sum by (pod)(container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\"}) / sum by (pod)(kube_pod_container_resource_limits{namespace=~\"$namespace\", pod=~\"$pod\", resource=\"memory\"})) * 100",
          "legendFormat": "{{ pod }} % Limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 102,
      "title": "Pod Networking & Traffic",
      "type": "row"
    },
    {
      "id": 10,
      "title": "Pod Network Receive Bandwidth (RX)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "sum by (pod)(rate(container_network_receive_bytes_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{ pod }} RX"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      }
    },
    {
      "id": 11,
      "title": "Pod Network Transmit Bandwidth (TX)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 21 },
      "targets": [
        {
          "expr": "sum by (pod)(rate(container_network_transmit_bytes_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{ pod }} TX"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "SynthetIQ Microservices Pod Health & Application Metrics",
      "type": "row"
    },
    {
      "id": 12,
      "title": "API Pod: HTTP Request Throughput (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "sum by (status)(rate(http_requests_total{job=~\"synthetiq-api.*\"}[5m])) or sum by (status)(rate(http_requests_total[5m]))",
          "legendFormat": "HTTP {{ status }}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 13,
      "title": "API Pod: HTTP p95 & p50 Response Latency",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le)(rate(http_request_duration_seconds_bucket{job=~\"synthetiq-api.*\"}[5m])))",
          "legendFormat": "p95 Latency"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le)(rate(http_request_duration_seconds_bucket{job=~\"synthetiq-api.*\"}[5m])))",
          "legendFormat": "p50 Latency"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 14,
      "title": "Worker Pod: Active Compliance Workflows",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 35 },
      "targets": [
        {
          "expr": "synthetiq_workflow_active_total",
          "legendFormat": "Active Workflows"
        },
        {
          "expr": "sum by (workflow_name)(rate(synthetiq_workflow_executions_total[5m]))",
          "legendFormat": "{{ workflow_name }} rate"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none" }
      }
    },
    {
      "id": 15,
      "title": "Worker Pod: JEV Reflex Evaluation Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 35 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(synthetiq_jev_evaluation_duration_seconds_bucket[5m]))",
          "legendFormat": "JEV p95 Latency"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 16,
      "title": "MCP Pod: Tool Execution & Gemma 2B PII Scrubbing",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 35 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(synthetiq_mcp_tool_duration_seconds_bucket[5m]))",
          "legendFormat": "{{ tool }} p95"
        },
        {
          "expr": "rate(synthetiq_mcp_pii_redactions_total[5m])",
          "legendFormat": "PII Redactions/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 17,
      "title": "Simulator Pod: Real-Time SCADA Telemetry Stream",
      "type": "stat",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 42 },
      "targets": [
        {
          "expr": "synthetiq_scada_stream_throughput_readings_per_sec",
          "legendFormat": "Readings/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 18,
      "title": "Infrastructure Pods: DB & Cache Health",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 42 },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"synthetiq\"} or vector(4)",
          "legendFormat": "PostgreSQL Active Backends"
        },
        {
          "expr": "redis_connected_clients or vector(2)",
          "legendFormat": "Redis Connected Clients"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none" }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["synthetiq", "pods", "kubernetes", "infrastructure", "health"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "synthetiq", "value": "synthetiq" },
        "hide": 0,
        "label": "Namespace",
        "name": "namespace",
        "options": [
          { "selected": true, "text": "synthetiq", "value": "synthetiq" },
          { "selected": false, "text": "default", "value": "default" }
        ],
        "query": "synthetiq, default",
        "type": "custom"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "hide": 0,
        "includeAll": true,
        "label": "Pod",
        "multi": true,
        "name": "pod",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "synthetiq-api", "value": "synthetiq-api.*" },
          { "selected": false, "text": "synthetiq-worker", "value": "synthetiq-worker.*" },
          { "selected": false, "text": "synthetiq-mcp", "value": "synthetiq-mcp.*" },
          { "selected": false, "text": "synthetiq-simulator", "value": "synthetiq-simulator.*" },
          { "selected": false, "text": "synthetiq-dashboard", "value": "synthetiq-dashboard.*" },
          { "selected": false, "text": "synthetiq-postgres", "value": ".*postgres.*" },
          { "selected": false, "text": "synthetiq-redis", "value": ".*redis.*" },
          { "selected": false, "text": "synthetiq-temporal", "value": ".*temporal.*" },
          { "selected": false, "text": "synthetiq-ollama", "value": ".*ollama.*" }
        ],
        "query": "synthetiq-api.*, synthetiq-worker.*, synthetiq-mcp.*, synthetiq-simulator.*, synthetiq-dashboard.*, .*postgres.*, .*redis.*, .*temporal.*, .*ollama.*",
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "SynthetIQ — Pods & Services Infrastructure Health",
  "uid": "synthetiq-pod-health"
}
